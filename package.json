{
  "name": "siomai-inventory",
  "productName": "Siomai Inventory",
  "version": "1.0.0",
  "description": "Offline inventory ledger for a Philippine food cart",
  "main": ".vite/build/main.cjs",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "test": "vitest run",
    "test:e2e": "electron-forge package && playwright test tests/e2e/app.spec.ts --workers=1 --output=out/e2e-results",
    "assets:generate": "node scripts/create-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "package": "electron-forge package",
    "check:package": "node scripts/check-package.mjs",
    "make:mac": "electron-forge make --platform=darwin --arch=universal",
    "make": "electron-forge make"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.52.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "44.5.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.1",
    "vitest": "^5.0.3"
  }
}
